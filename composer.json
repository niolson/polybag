{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "polybag/polybag",
    "type": "project",
    "description": "Barcode-driven shipping workstation for packing and labeling shipments.",
    "keywords": ["shipping", "fulfillment", "laravel", "filament"],
    "license": "BUSL-1.1",
    "require": {
        "php": "^8.4",
        "commerceguys/addressing": "^2.2",
        "enshrined/svg-sanitize": "^1.0",
        "filament/filament": "~5.0",
        "giggsey/libphonenumber-for-php": "^9.0",
        "laravel/framework": "^13.0",
        "laravel/scout": "^11.2",
        "laravel/socialite": "^5.26",
        "laravel/tinker": "^3.0",
        "picqer/php-barcode-generator": "^3.2",
        "resend/resend-php": "^1.6",
        "saloonphp/laravel-plugin": "^4.0",
        "saloonphp/saloon": "^4.0",
        "sentry/sentry-laravel": "^4.25",
        "smalot/pdfparser": "^2.12",
        "socialiteproviders/microsoft-azure": "^5.2"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.7",
        "fakerphp/faker": "^1.23",
        "itsgoingd/clockwork": "^5.3",
        "justinrainbow/json-schema": "^6.11",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.4",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.27",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^4.2",
        "pestphp/pest-plugin-browser": "^4.3",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently --kill-others-on-fail -c \"#93c5fd,#c4b5fd,#a5b4fc,#fdba74,#86efac\" \"php artisan serve\" \"php artisan queue:listen --queue=default,low --tries=1\" \"php artisan queue:listen imports --queue=imports --tries=1\" \"npm run dev\" \"php artisan schedule:work\" --names='server,queue,import-queue,vite,scheduler'"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test --parallel --processes=auto --max-processes=16 --passthru-php=\"'-d' 'opcache.enable_cli=1'\""
        ],
        "test:ci": [
            "@php artisan test --parallel --processes=auto --max-processes=16 --passthru-php=\"'-d' 'opcache.enable_cli=1'\" --coverage --coverage-clover=coverage.xml"
        ],
        "test:serial": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "test:external": [
            "@php artisan config:clear --ansi",
            "@php artisan test tests/External"
        ],
        "test:fedex-reference": [
            "@php artisan config:clear --ansi",
            "@php artisan test tests/External/Fedex"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-install-cmd": [
            "@php -r \"is_dir('.git') && shell_exec('git config core.hooksPath .githooks');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php -r \"is_dir('.git') && shell_exec('git config core.hooksPath .githooks');\""
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "format": "vendor/bin/rector process && vendor/bin/phpstan analyse && vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "audit": {
            "ignore": {}
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

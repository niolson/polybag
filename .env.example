APP_NAME=PolyBag
# APP_ENV options: local (dev settings UI), demo (sandbox APIs forced + demo banner), production
APP_ENV=local
APP_KEY=
# During APP_KEY rotation, keep old keys comma-separated here until
# `php artisan app:reencrypt-secrets` succeeds, then remove them.
# APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost

# Multi-tenant feature flags (production/demo only — ignored in local, use Dev Settings UI instead)
MULTI_CLIENT_ENABLED=false
MULTI_LOCATION_ENABLED=false

# Deployment Modes:
# -----------------------------------------------------------------
# Standalone (on-prem): DB_HOST=mysql, REDIS_HOST=redis
#   Start with: docker compose --profile standalone up -d
#
# Shared (multi-tenant): DB_HOST=shared-mysql, REDIS_HOST=shared-redis
#   Requires shared infra running (see infra/docker-compose.yml)
#   Start with: docker compose up -d
#
# External (managed): DB_HOST=rds.example.com, REDIS_HOST=cache.example.com
#   Point to your managed database/cache services
#   Start with: docker compose up -d
# -----------------------------------------------------------------

# Docker network the app/queue/scheduler join to reach the shared datastores.
# Shared mode sets this to a per-tenant network (shared-<tenant>) so tenants are
# isolated from each other; leave as `shared` for standalone/on-prem. See issue 16.
SHARED_NETWORK=shared

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
# Production: Set SESSION_SECURE_COOKIE=true (requires HTTPS)
# Production: Set SESSION_ENCRYPT=true

# Hosted multi-tenant fleet only — leave unset for on-prem installs. See
# config/app.php "Instance Directory Cookie Domain".
INSTANCE_COOKIE_DOMAIN=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX= (must be unique per instance if sharing Redis)

# Redis key prefix — required when sharing Redis across tenants
# REDIS_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Any Laravel mailer works (smtp, ses, postmark, resend, sendmail, log). Send from
# a domain you control and have authenticated (SPF/DKIM/DMARC). MFA login codes go
# through this, so it stops being optional once Require MFA is enabled in Settings.
#   e.g. MAIL_MAILER=smtp / MAIL_FROM_ADDRESS="noreply@example.com"
# RESEND_API_KEY is read only when MAIL_MAILER=resend. See docs/self-hosting.md.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Dev only: false turns off Vite's websocket. Chrome closes it in hidden tabs
# and Vite then reloads the page; the cost is refreshing by hand after edits.
# VITE_HMR=false

# On-prem: port for nginx when not using Caddy reverse proxy
# APP_PORT=80

# QZ Tray certificate paths (override for shared/custom locations)
# QZ_PRIVATE_KEY_PATH=./storage/app/private/qz-private-key.pem
# QZ_CERTIFICATE_PATH=./public/qz-certificate.pem

# Carrier, Shopify, Amazon, and import-source credentials are configured in the app settings UI.

# Google SSO (optional — enable via Settings page)
# Your own Google Cloud OAuth client; redirect URI /auth/google/callback.
# Required for SSO unless an OAuth broker is configured (see below).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Address Validation API (optional — universal address validator; runs
# behind USPS for US addresses and is the only validator for non-US ones).
# Not the SSO credential above. Without an OAuth broker this direct key is the
# production path — set it, or leave it empty and addresses stay Not Checked.
# Enable the Address Validation API in Google Cloud; Google bills per request.
GOOGLE_ADDRESS_VALIDATION_API_KEY=

# Azure / Microsoft Entra SSO (optional — enable via Settings page)
# Your own Entra app registration; redirect URI /auth/azure/callback.
# Required for SSO unless an OAuth broker is configured (see below).
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=common

# OAuth Broker — hosted PolyBag only. Leave these three empty.
# The broker is a service POLYBAG.APP LLC operates; it holds *our* carrier and IdP
# developer credentials, so a third party cannot be issued an OAUTH_BROKER_SECRET
# and there is no self-hostable build of it.
#
# Empty is a supported configuration, not a broken one. Every integration has a
# bring-your-own-credentials path: carrier developer app keys go on Carrier Account
# records, Shopify/Amazon credentials on Data Source records, and SSO uses the
# GOOGLE_/AZURE_ keys above. The "Connect ..." buttons in the UI drive the broker's
# authorization-code flow and stay disabled without it. See docs/self-hosting.md.
OAUTH_BROKER_URL=
OAUTH_BROKER_SECRET=
OAUTH_INSTANCE_ID=
# Only meaningful when OAUTH_BROKER_URL is set: routes SSO directly through the
# GOOGLE_/AZURE_ credentials above while other integrations still use the broker.
OAUTH_BYPASS_BROKER=false

# E2E Testing (registers fake carrier adapters and address validator)
FAKE_CARRIERS=false

# Sentry error tracking. Production: injected via shared-secrets.env.
# Leave traces sample rate unset/0 — performance tracing burns event quota.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_ENVIRONMENT=

# Carrier API payload logging (fedex/usps/ups-validation channels) is always
# on; PII is redacted by default. Set this to true to log unredacted —
# needed for FedEx certification runs — and only for that or local
# debugging. MUST stay false in production otherwise.
CARRIER_API_LOGGING=false

# PDF Renderer (optional — enables QZ Tray printing of pick batch documents)
# Only the standalone/on-prem stack ships a Gotenberg container of its own
# (see docker-compose.onprem.yml); there, use http://gotenberg:3000. Any other
# deployment has to run Gotenberg itself and point this at it. Leave blank to
# disable PDF rendering.
#   Local, outside Docker: http://127.0.0.1:3000
GOTENBERG_URL=

# Shipment import behavior. Sources themselves are configured as Data Source
# records in the app, not here.
SHIPMENT_IMPORT_BATCH_SIZE=100
SHIPMENT_IMPORT_AUTO_UPDATE_PRODUCTS=true
SHIPMENT_IMPORT_LOG_CHANNEL=shipment-import
